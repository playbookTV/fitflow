{{!< default}}

<div class="container">
  <header class="archive-header">
    <p class="archive-label">Tag</p>
    <h1>{{name}}</h1>
    {{#if description}}
      <p>{{description}}</p>
    {{/if}}
  </header>

  <div class="post-feed">
    {{#foreach posts}}
      {{> post-card}}
    {{/foreach}}
  </div>

  {{#if pagination.pages}}
    <nav class="pagination">
      {{#if pagination.prev}}
        <a href="{{pagination.prev}}">&larr; Newer</a>
      {{/if}}
      <span>Page {{pagination.page}} of {{pagination.pages}}</span>
      {{#if pagination.next}}
        <a href="{{pagination.next}}">Older &rarr;</a>
      {{/if}}
    </nav>
  {{/if}}
</div>
