{{!< default}}

<article class="post {{post_class}}">
  <div class="container">
    <header class="post-header">
      {{#if primary_tag}}
        <a href="{{primary_tag.url}}" class="post-tag">{{primary_tag.name}}</a>
      {{/if}}

      <h1>{{title}}</h1>

      <div class="post-meta">
        {{#if primary_author.profile_image}}
          <img class="author-avatar" src="{{img_url primary_author.profile_image size="xs"}}" alt="{{primary_author.name}}">
        {{/if}}
        <span>{{primary_author.name}}</span>
        <span>&middot;</span>
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date published_at format="D MMM YYYY"}}</time>
        <span>&middot;</span>
        <span class="reading-time">{{reading_time}}</span>
      </div>
    </header>
  </div>

  {{#if feature_image}}
    <figure class="post-feature-image">
      <img
        srcset="{{img_url feature_image size="m"}} 600w,
                {{img_url feature_image size="l"}} 1000w,
                {{img_url feature_image size="xl"}} 2000w"
        sizes="(max-width: 1200px) 100vw, 1200px"
        src="{{img_url feature_image size="xl"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
      >
      {{#if feature_image_caption}}
        <figcaption>{{feature_image_caption}}</figcaption>
      {{/if}}
    </figure>
  {{/if}}

  <section class="gh-content">
    {{content}}
  </section>
</article>

{{> newsletter-form}}
