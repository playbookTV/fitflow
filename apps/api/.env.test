# FitFlow API — Test Environment
# Used by vitest via setupFiles

NODE_ENV=test

# Database (use a separate test database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fitflow_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/fitflow_test

# Supabase (mocked in tests, but env must be present)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=test-service-key

# Meta Cloud API (mocked in tests)
META_WHATSAPP_ACCESS_TOKEN=test-access-token
META_WHATSAPP_PHONE_NUMBER_ID=test-phone-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=test-business-id
META_WHATSAPP_VERIFY_TOKEN=test-verify-token
META_APP_SECRET=test-app-secret
META_WHATSAPP_DISPLAY_NUMBER=441234567890

# Anthropic (mocked in tests)
ANTHROPIC_API_KEY=test-anthropic-key

# Stripe (mocked in tests)
STRIPE_SECRET_KEY=sk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_test_fake
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_sub_test_fake

# Redis (use separate test port)
REDIS_URL=redis://localhost:6380

# App
API_BASE_URL=http://localhost:3001
WEB_URL=http://localhost:3000
PORT=3001

# Background processing — disable in tests
ENABLE_BACKGROUND_JOBS=false
ENABLE_SCHEDULERS=false
ENABLE_WORKERS=false

# Telegram (mocked)
DEFAULT_TG_BOT_TOKEN=test-bot-token
