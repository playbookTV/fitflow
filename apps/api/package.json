{
    "name": "@fitflow/api",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/index.js",
        "worker:start": "tsx watch src/workers/index.ts",
        "type-check": "tsc --noEmit",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "stripe:seed": "tsx scripts/stripe-seed-prices.ts",
        "docs:generate": "tsx src/docs/generate.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@bull-board/api": "^6.2.0",
        "@bull-board/express": "^6.2.0",
        "@fitflow/shared": "workspace:*",
        "@prisma/client": "^5.22.0",
        "@sentry/node": "^10.51.0",
        "@supabase/supabase-js": "^2.47.0",
        "axios": "^1.13.5",
        "bullmq": "^5.26.2",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-basic-auth": "^1.2.1",
        "express-rate-limit": "^8.3.2",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.1",
        "node-cron": "^3.0.3",
        "posthog-node": "^4.4.3",
        "qrcode": "^1.5.4",
        "stripe": "^17.7.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^20.17.6",
        "@types/node-cron": "^3.0.11",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^7.2.0",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/coverage-v8": "^4.1.4",
        "prisma": "^5.22.0",
        "supertest": "^7.2.2",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^4.1.4"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}