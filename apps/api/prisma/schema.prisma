generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Coach {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String?
  slug              String?   @unique
  phone             String?
  businessName      String?   @map("business_name")
  timezone          String    @default("Africa/Lagos")
  stripeAccountId   String?   @map("stripe_account_id")
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  billingCurrency   String    @default("usd") @map("billing_currency")
  defaultChannel    MessageChannel? @map("default_channel")
  specialities      String[]  @default([])
  defaultPaymentModel PaymentModel? @map("default_payment_model")
  activeClientRange String?   @map("active_client_range")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingStep    Int       @default(0) @map("onboarding_step")

  // Public profile (ftfw.fit)
  bio                     String?
  avatarUrl               String?   @map("avatar_url")
  profileVisible          Boolean   @default(true)  @map("profile_visible")
  showRatesPublicly       Boolean   @default(true)  @map("show_rates_publicly")
  showWhatsapp            Boolean   @default(true)  @map("show_whatsapp")
  showTelegram            Boolean   @default(true)  @map("show_telegram")
  defaultPricePerSession  Int?      @map("default_price_per_session")
  defaultSessionsPerBlock Int?      @map("default_sessions_per_block")
  defaultMonthlyRate      Int?      @map("default_monthly_rate")

  clients           Client[]
  subscription      Subscription?
  plans             WorkoutPlan[]
  templates         WorkoutPlan[] @relation("CoachTemplates")
  mealPlans         MealPlan[]
  mealTemplates     MealPlan[] @relation("CoachMealTemplates")
  shortLinks        ShortLink[]
  botRegistry       BotRegistry?
  offers            Offer[]
  leads             Lead[]
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("coaches")
}

model Client {
  id                String    @id @default(uuid())
  coachId           String    @map("coach_id")
  coach             Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name              String
  phone             String?   @unique
  email             String?
  telegramChatId    String?   @unique @map("telegram_chat_id")
  goals             String?
  notes             String?
  status            ClientStatus @default(PENDING_PAYMENT)
  intakeToken       String?   @unique @map("intake_token")
  timezone          String    @default("Europe/London")
  preferredChannel  MessageChannel @default(WHATSAPP) @map("preferred_channel")
  monthlyRate       Int?          @map("monthly_rate")

  assignments       PlanAssignment[]
  mealAssignments   MealAssignment[]
  checkIns          CheckIn[]
  workoutLogs       WorkoutLog[]
  mealLogs          MealLog[]
  payments          Payment[]
  messages          Message[]
  sessionBlocks     SessionBlock[]

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("clients")
}

enum MessageChannel {
  WHATSAPP
  TELEGRAM
}

enum PaymentModel {
  SESSION_BLOCKS
  PER_SESSION
  MONTHLY_RETAINER
}

enum ClientStatus {
  PENDING_PAYMENT
  INTAKE_SENT
  INTAKE_COMPLETE
  PLAN_ASSIGNED
  ACTIVE
  PAUSED
  INACTIVE
}

model WorkoutPlan {
  id                String    @id @default(uuid())
  coachId           String    @map("coach_id")
  coach             Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  isTemplate        Boolean   @default(false) @map("is_template")
  ownerCoachId      String?   @map("owner_coach_id")
  ownerCoach        Coach?    @relation("CoachTemplates", fields: [ownerCoachId], references: [id])
  title             String
  description       String?

  days              WorkoutDay[]
  assignments       PlanAssignment[]

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("workout_plans")
}

model WorkoutDay {
  id                String    @id @default(uuid())
  planId            String    @map("plan_id")
  plan              WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber         Int       @map("day_number")
  title             String?

  exercises         WorkoutExercise[]

  @@map("workout_days")
}

model WorkoutExercise {
  id                String    @id @default(uuid())
  dayId             String    @map("day_id")
  day               WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId        String    @map("exercise_id")
  exercise          Exercise  @relation(fields: [exerciseId], references: [id])
  order             Int
  sets              Int
  reps              String?
  rest              String?
  notes             String?

  @@map("workout_exercises")
}

model Exercise {
  id                String    @id @default(uuid())
  name              String    @unique
  category          String
  muscles           String[]
  demoVideoUrl      String?   @map("demo_video_url")
  ymoveId           String?   @unique @map("ymove_id")
  workoutExercises  WorkoutExercise[]

  @@map("exercises")
}

model PlanAssignment {
  id                String    @id @default(uuid())
  clientId          String    @map("client_id")
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId            String    @map("plan_id")
  plan              WorkoutPlan @relation(fields: [planId], references: [id])
  startDate         DateTime  @map("start_date")
  scheduleDays      Int[]     @map("schedule_days") // [1, 3, 5] for Mon, Wed, Fri
  isActive          Boolean   @default(true) @map("is_active")
  compliance        Int       @default(100)
  workoutLogs       WorkoutLog[]

  @@map("plan_assignments")
}

model CheckIn {
  id                String    @id @default(uuid())
  clientId          String    @map("client_id")
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weight            Float?
  energy            Int?      // 1-5
  sleep             String?
  notes             String?
  photoUrl          String?   @map("photo_url")

  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("check_ins")
}

model WorkoutLog {
  id                String    @id @default(uuid())
  clientId          String    @map("client_id")
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignmentId      String    @map("assignment_id")
  assignment        PlanAssignment @relation(fields: [assignmentId], references: [id])
  dayNumber         Int       @map("day_number")
  status            WorkoutStatus @default(COMPLETED)
  notes             String?

  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("workout_logs")
}

enum WorkoutStatus {
  COMPLETED
  SKIPPED
  MODIFIED
}

model Payment {
  id                String    @id @default(uuid())
  clientId          String    @map("client_id")
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stripeSessionId   String?   @unique @map("stripe_session_id")
  amount            Int       // In cents
  currency          String    @default("gbp")
  status            PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod @default(STRIPE) @map("payment_method")
  confirmedBy       String?   @map("confirmed_by") // Coach ID for manual bank transfer confirmations

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
}

model SessionBlock {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  totalSessions   Int      @map("total_sessions")
  usedSessions    Int      @default(0) @map("used_sessions")
  pricePerSession Int      @map("price_per_session")
  currency        String   @default("usd")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("session_blocks")
}

model Message {
  id                String    @id @default(uuid())
  clientId          String?   @map("client_id")
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId            String?   @map("lead_id")
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel           MessageChannel
  direction         MessageDirection
  content           String
  metaMessageId     String?   @unique @map("meta_message_id")
  status            String?   // delivered, read, etc.

  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Offer {
  id            String          @id @default(uuid())
  coachId       String          @map("coach_id")
  coach         Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  channelParam  MessageChannel? @map("channel_param")
  sourceTags    String[]        @map("source_tags")
  ctaType       String?         @map("cta_type")
  paymentRoute  String?         @map("payment_route")
  isActive      Boolean         @default(true) @map("is_active")
  leads         Lead[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([coachId, slug])
  @@map("offers")
}

model Lead {
  id              String          @id @default(uuid())
  coachId         String          @map("coach_id")
  coach           Coach           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  offerId         String?         @map("offer_id")
  offer           Offer?          @relation(fields: [offerId], references: [id])
  name            String
  phone           String?
  email           String?
  telegramChatId  String?         @map("telegram_chat_id")
  channelTag      MessageChannel  @map("channel_tag")
  source          String?
  intakeData      Json?           @map("intake_data")
  status          LeadStatus      @default(NEW)
  messages        Message[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("leads")
}

enum LeadStatus {
  NEW
  INTAKE_COMPLETE
  PAYMENT_PENDING
  CONVERTED
  REJECTED
}

model BotRegistry {
  id            String   @id @default(uuid())
  coachId       String   @unique @map("coach_id")
  coach         Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  botToken      String   @map("bot_token")
  botUsername   String   @map("bot_username")
  webhookUrl    String   @map("webhook_url")
  webhookSecret String?  @map("webhook_secret") // Used to verify X-Telegram-Bot-Api-Secret-Token
  provisionedAt DateTime @default(now()) @map("provisioned_at")

  @@map("bot_registry")
}

// ═══════════════════════════════════════════════════════════════
// MEAL PLANNING
// ═══════════════════════════════════════════════════════════════

model MealPlan {
  id            String   @id @default(uuid())
  coachId       String   @map("coach_id")
  coach         Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  isTemplate    Boolean  @default(false) @map("is_template")
  ownerCoachId  String?  @map("owner_coach_id")
  ownerCoach    Coach?   @relation("CoachMealTemplates", fields: [ownerCoachId], references: [id])
  title         String
  description   String?
  days          MealDay[]
  assignments   MealAssignment[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("meal_plans")
}

model MealDay {
  id        String      @id @default(uuid())
  planId    String      @map("plan_id")
  plan      MealPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber Int         @map("day_number")
  title     String?
  entries   MealEntry[]

  @@map("meal_days")
}

model MealEntry {
  id          String  @id @default(uuid())
  dayId       String  @map("day_id")
  day         MealDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  mealId      String  @map("meal_id")
  meal        Meal    @relation(fields: [mealId], references: [id])
  order       Int
  servingSize String? @map("serving_size")
  notes       String?

  @@map("meal_entries")
}

model Meal {
  id             String      @id @default(uuid())
  name           String      @unique
  category       String      // breakfast, lunch, dinner, snack
  protein        Float?
  carbs          Float?
  fat            Float?
  calories       Int?
  ingredients    String[]
  prepTime       String?     @map("prep_time")
  recipeUrl      String?     @map("recipe_url")
  spoonacularId  Int?        @unique @map("spoonacular_id")
  imageUrl       String?     @map("image_url")
  entries        MealEntry[]

  @@map("meals")
}

model MealAssignment {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId       String   @map("plan_id")
  plan         MealPlan @relation(fields: [planId], references: [id])
  startDate    DateTime @map("start_date")
  scheduleDays Int[]    @map("schedule_days")
  isActive     Boolean  @default(true) @map("is_active")
  compliance   Int      @default(100)
  mealLogs     MealLog[]

  @@map("meal_assignments")
}

model MealLog {
  id           String         @id @default(uuid())
  clientId     String         @map("client_id")
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignmentId String         @map("assignment_id")
  assignment   MealAssignment @relation(fields: [assignmentId], references: [id])
  dayNumber    Int            @map("day_number")
  status       MealStatus     @default(COMPLETED)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("meal_logs")
}

enum MealStatus {
  COMPLETED
  SKIPPED
  MODIFIED
}

model ShortLink {
  id        String   @id @default(uuid())
  coachId   String   @map("coach_id")
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  code      String   @unique
  targetUrl String   @map("target_url")
  label     String?
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("short_links")
}

// ═══════════════════════════════════════════════════════════════
// COACH SUBSCRIPTIONS (SaaS billing)
// ═══════════════════════════════════════════════════════════════

model Subscription {
  id                   String             @id @default(uuid())
  coachId              String             @unique @map("coach_id")
  coach                Coach              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  stripePriceId        String             @map("stripe_price_id")
  tier                 SubscriptionTier   @default(STARTER)
  billingInterval      BillingInterval    @default(MONTHLY)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  trialEnd             DateTime?          @map("trial_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@map("subscriptions")
}

enum SubscriptionTier {
  STARTER
  PRO
  STUDIO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model EventLog {
  id          String          @id @default(uuid())
  coachId     String?         @map("coach_id")
  clientId    String?         @map("client_id")
  eventType   String          @map("event_type")
  channel     MessageChannel?
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([coachId])
  @@index([clientId])
  @@index([eventType])
  @@map("event_logs")
}

// ═══════════════════════════════════════════════════════════════
// VANITY URL (ftfw.fit)
// ═══════════════════════════════════════════════════════════════

model SlugRedirect {
  id        String   @id @default(uuid())
  oldSlug   String   @unique @map("old_slug")
  newSlug   String   @map("new_slug")
  coachId   String   @map("coach_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("slug_redirects")
}

model ProfileEvent {
  id        String   @id @default(uuid())
  coachSlug String   @map("coach_slug")
  coachId   String   @map("coach_id")
  event     String   // viewed | channel_click | redirect | link_copied
  channel   String?  // wb | tg
  source    String?  // direct | wb_link | tg_link
  ipHash    String   @map("ip_hash")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([coachId])
  @@index([coachSlug])
  @@index([event])
  @@map("profile_events")
}
