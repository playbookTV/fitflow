# FitFlow API — Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_KEY="[SERVICE_ROLE_KEY]"

# Meta Cloud API (WhatsApp)
META_WHATSAPP_ACCESS_TOKEN="[PERMANENT_ACCESS_TOKEN]"
META_WHATSAPP_PHONE_NUMBER_ID="[PHONE_NUMBER_ID]"
META_WHATSAPP_BUSINESS_ACCOUNT_ID="[BUSINESS_ACCOUNT_ID]"
META_WHATSAPP_VERIFY_TOKEN="[YOUR_CUSTOM_VERIFY_TOKEN]"
META_WHATSAPP_DISPLAY_NUMBER="[YOUR_WHATSAPP_PHONE_NUMBER e.g. 447395728304]"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Redis (Upstash or Railway)
REDIS_URL="redis://localhost:6379"

# App
API_BASE_URL="https://your-api-domain.up.railway.app"
WEB_URL="http://localhost:3000"
PORT=3001
NODE_ENV="development"

# YMove Exercise API
YMOVE_API_KEY="ym_your_key_here"
YMOVE_BASE_URL="https://exercise-api.ymove.app/api/v2"

# Anthropic (for Claude Haiku parser fallback)
ANTHROPIC_API_KEY="sk-ant-..."

# Telegram Bot (auto-provisions on startup if set)
DEFAULT_COACH_ID=""
DEFAULT_TG_BOT_TOKEN=""

# Background processing
# Defaults to enabled in development and disabled in production.
# Optional fine-grained overrides
# ENABLE_BACKGROUND_JOBS="true"
# ENABLE_WORKERS="true"
# ENABLE_SCHEDULERS="true"
