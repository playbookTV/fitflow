# FitFlow Web — Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"

# API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Stripe (publishable key only — safe for client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Sentry — leave NEXT_PUBLIC_SENTRY_DSN unset to disable client/server reporting.
# SENTRY_AUTH_TOKEN/ORG/PROJECT are only required at build time to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
